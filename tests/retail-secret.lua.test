-- Retail: restricted cooldowns are estimated, and the display never mixes end-time and remaining-duration frames.
local secret = {}
local now = 1000
local restricted = false
local created = {}
local cd = {}

local function isMethod(key)
    return type(key) == "string" and (key:match("^Set") or key:match("^Get") or key:match("^Clear")
        or key:match("^Register") or key:match("^Unregister") or key:match("^Create")
        or key:match("^Enable") or key:match("^Stop") or key:match("^Start"))
end

local function newFrame()
    local frame = { scripts = {}, shown = false }
    return setmetatable(frame, {
        __index = function(_, key)
            if key == "SetScript" then
                return function(target, event, handler) target.scripts[event] = handler end
            elseif key == "Show" then
                return function(target) target.shown = true end
            elseif key == "Hide" then
                return function(target) target.shown = false end
            elseif key == "CreateTexture" or key == "CreateFontString" then
                return function() return newFrame() end
            elseif isMethod(key) then
                return function() end
            end
            return nil
        end,
    })
end

local frame = newFrame()
frame.SetupOptions = function() end
local media = { Fetch = function() return "test" end, IsValid = function() return true end }
LibStub = function(name)
    if name == "AceAddon-3.0" then
        return { GetAddon = function() return { MainFrame = frame, Debug = function() end, Trace = function() end } end }
    end
    return media
end

floor = math.floor
GetBuildInfo = function() return nil, nil, nil, 120105 end
WOW_PROJECT_MAINLINE, WOW_PROJECT_ID = 1, 1
GetTime = function() return now end
UnitClass = function() return nil, "MAGE" end
UnitExists = function() return false end
HasPetUI = function() return false end
C_PetBattles = { IsInBattle = function() return false end }
UnitHasVehicleUI = function() return false end
IsLoggedIn = function() return false end
CreateFrame = function() local f = newFrame(); created[#created + 1] = f; return f end
UIParent = newFrame()
CoolLineDB = { hidebag = true, hideinv = true, hidepet = true, hidefail = true }
issecretvalue = function(value) return value == secret end
GetSpellBaseCooldown = function() return 15000 end

C_Spell = {
    GetSpellInfo = function(id) return { name = "Spell" .. id, iconID = 100 + id, spellID = id } end,
    GetSpellCharges = function() return nil end,
    GetSpellCooldown = function(id)
        local s = cd[id]
        if not s then return nil end
        return { startTime = restricted and secret or (s.active and s.start or 0),
            duration = restricted and secret or (s.active and s.duration or 0),
            isEnabled = true, isActive = s.active, isOnGCD = s.gcd or false }
    end,
    GetSpellCooldownDuration = function(id)
        local s = cd[id]
        return { GetRemainingDuration = function()
            if restricted then return secret end
            if not s or not s.active then return 0 end
            return s.start + s.duration - now
        end }
    end,
    GetSpellChargeDuration = function() return nil end,
}

assert(loadfile("compat.lua"))("CoolLine")
assert(loadfile("timeline.lua"))("CoolLine")
assert(loadfile("core.lua"))("CoolLine")
assert(loadfile("spellbook.lua"))("CoolLine")
local throttle = created[1]
assert(frame.CLIENT == "retail")

frame:ADDON_LOADED("CoolLine")
frame:PLAYER_LOGIN()

local function fire(event, ...) frame.scripts.OnEvent(frame, event, ...) end
local function flush(dt)
    now = now + dt
    if throttle.shown then throttle.scripts.OnUpdate(throttle, dt) end
end
local function frameOf(id)
    for _, f in ipairs(frame.cooldowns) do
        if f.spellID == id then return f end
    end
end
local function render() frame.scripts.OnUpdate(frame, 2) end

frame.spells.spell[100] = "Spell100"
frame.spells.spell[200] = "Spell200"

-- 1. Readable cooldown: duration-based frame, as before.
cd[100] = { start = 1000, duration = 12, active = true }
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
local f100 = frameOf(100)
assert(f100 and f100.remaining_duration and not f100.endtime and not f100.estimated, "readable retail cooldown")

-- 2. Restriction starts: the exact end is kept instead of being dropped or downgraded.
restricted = true
now = 1002
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
assert(frameOf(100) == f100 and f100.remaining_duration and not f100.endtime and not f100.estimated,
    "an exact retail cooldown survives the restriction")
render()

-- 3. A cooldown that starts while restricted is rejected during the global cooldown, then confirmed and estimated.
now = 1004
cd[200] = { start = 1004, duration = 25, active = true, gcd = true }
fire("UNIT_SPELLCAST_SUCCEEDED", "player", "guid", 200)
fire("SPELL_UPDATE_COOLDOWN")
assert(not frameOf(200), "global-cooldown activity is not shown")
cd[200].gcd = false
fire("SPELL_UPDATE_COOLDOWN")
assert(not frameOf(200), "a new restricted cooldown must be confirmed first")
flush(2.6)
local f200 = frameOf(200)
assert(f200 and f200.estimated and f200.endtime == 1004 + 15 and f200.estimateLabel.shown,
    "restricted retail cooldown is estimated from the observed cast")
render()

-- 4. The game reports the real ends while still restricted.
now = 1012
cd[100].active = false
fire("SPELL_UPDATE_COOLDOWN")
assert(not frameOf(100), "exact cooldown ends")
now = 1017
cd[200].active = false
fire("SPELL_UPDATE_COOLDOWN")
assert(not frameOf(200), "estimated cooldown ends when the game says so")

-- 5. An estimated frame is reconciled with readable timing when the restriction ends.
now = 1030
cd[200] = { start = 1030, duration = 20, active = true }
fire("UNIT_SPELLCAST_SUCCEEDED", "player", "guid", 200)
fire("SPELL_UPDATE_COOLDOWN")
flush(2.6)
f200 = frameOf(200)
assert(f200 and f200.estimated and f200.endtime == 1030 + 13, "estimate uses the observed duration")
restricted = false
now = 1033
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
assert(frameOf(200) == f200 and not f200.estimated and f200.endtime == now + (1030 + 20 - now),
    "readable timing replaces the estimate without losing the frame")
assert(not f200.estimateLabel.shown, "the estimate marker is hidden")
render()

-- 6. After the cooldown, the recycled frame goes back to duration mode with no stale end time.
now = 1051
cd[200].active = false
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
assert(not frameOf(200), "readable cooldown ends")
now = 1052
cd[100] = { start = 1052, duration = 12, active = true }
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
f100 = frameOf(100)
assert(f100 and f100.remaining_duration and f100.endtime == nil and not f100.estimated,
    "a recycled frame must not keep the previous end time")

-- 7. An exact retail cooldown that outlives its end while restricted becomes an estimate.
restricted = true
now = 1066
fire("SPELL_UPDATE_COOLDOWN")
flush(0.4)
assert(frameOf(100) == f100 and f100.estimated and f100.endtime == 1052 + 12 and f100.confirmedAt == now,
    "an overdue exact cooldown becomes an estimate that keeps its end and records the confirmation")
render()

print("Retail secret cooldown tests passed")
